# Copy to .env and fill in only what you need. Never commit .env.
#
# Every value below is OPTIONAL at configuration-load time. The settings object
# loads successfully with this file absent and every variable unset, because the
# deterministic pipeline and the evaluator app must both run with no API key
# (spec Sections 13.1, 22.3, 23). Requiredness is enforced at the point of use:
# the stage that needs a credential raises ConfigError when it is missing.

# --- Model providers ---------------------------------------------------------
# Anthropic remains implemented (ADR-14). Groq is a provisional Phase 4
# relevance-smoke provider (ADR-31), not a claim that it is better.
# The OpenAI adapter is stretch scope (ADR-27).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# --- Author hashing ----------------------------------------------------------
# HMAC salt for author_hash (spec Section 26.1). Rotating this changes every
# author_hash in the corpus, so it is set once per corpus and then left alone.
# The manifest records it by hash (author_salt_id), never by value.
AUTHOR_SALT=

# --- Reddit: optional, credential-dependent (spec Section 11.4) --------------
# Required even for read-only access: unauthenticated traffic from a hosted
# netblock is blocked. The collector skips cleanly when these are absent.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# --- YouTube: supported automated source (spec Section 11.4) -----------------
YOUTUBE_API_KEY=

# No Play Store, App Store, or support-forum credentials appear here. Both store
# APIs authenticate the app's publisher and the forum has no permission basis,
# so all three sources are collected by manual import (ADR-22).
